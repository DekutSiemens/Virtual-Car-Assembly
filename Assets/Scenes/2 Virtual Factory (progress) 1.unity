  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The ABB FlexPendant is used to jog and position the workpiece manually.\nOperators
    can record waypoints to define rotation angles and movement sequences.\nThe positioner
    is linked to the robot's coordinate system, allowing smooth synchronization between
    robot movements and positioner adjustments.\n\nExample RAPID code for defining
    a positioner movement:\nMoveJ p1, v100, z0, tool0; \nMoveJ p2, v100, z0, workpiece_positioner;\n\nHere,
    p1 and p2 define different positions, and workpiece_positioner refers to the
    IRBP\u2019s rotation angle."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5b036e831c0c90547b32a8a896d80f79, type: 2}
  m_sharedMaterial: {fileID: 2427308795250815149, guid: 5b036e831c0c90547b32a8a896d80f79, type: 2}
